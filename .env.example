# Broker (Kite) settings the API needs to start. Copy to .env and fill in; never commit .env.
KITE_API_KEY=
KITE_API_SECRET=
# Kite calls back on the API's own host.
KITE_REDIRECT_URL=http://127.0.0.1:8765/kite/callback
# Where the browser lands after the callback: the FRONTEND origin (scheme://host[:port], no path). The API serves no
# pages, so a bare path would 404 (#159). The vite preview port in frontend/README.md.
FRONTEND_ORIGIN=http://127.0.0.1:4173
KITE_EXPECTED_USER_ID=
BROKER_TOKEN_KEY=
