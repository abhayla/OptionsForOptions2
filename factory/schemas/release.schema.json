{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://startup-factory/schemas/release.schema.json",
  "title": "Release",
  "description": "releases/R-###.md frontmatter. items lists every requirement (REQ-###) the release delivered, optionally its work items (W-###); each listed requirement names this record back in its release field (REQ-016, checked by tools/trace_check.py). kind production (the default when absent): authorization required with required: true, and only status deployed counts as delivered. kind kit (a kit version, nothing deployed): status must be released; authorization is optional.",
  "type": "object",
  "required": ["id", "version", "date", "items", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^R-\\d{3,}$" },
    "kind": { "type": "string", "enum": ["kit", "production"] },
    "version": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(REQ|W)-\\d{3,}$" } },
    "status": {
      "type": "string",
      "enum": ["preparing", "ready", "authorized", "deployed", "rolled_back", "cancelled", "released"]
    },
    "environments": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "rollback_plan": { "type": "string" },
    "backup_restore_check": { "type": "string" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "authorization": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "record": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "kit" } }, "required": ["kind"] },
      "then": { "properties": { "status": { "const": "released" }, "environments": { "maxItems": 0 } } },
      "else": {
        "required": ["authorization"],
        "properties": {
          "status": { "not": { "const": "released" } },
          "authorization": { "properties": { "required": { "const": true } } }
        }
      }
    }
  ],
  "additionalProperties": true
}
