{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://startup-factory/schemas/release.schema.json",
  "title": "Release",
  "description": "releases/R-###.md frontmatter",
  "type": "object",
  "required": ["id", "version", "items", "status", "authorization"],
  "properties": {
    "id": { "type": "string", "pattern": "^R-\\d{3,}$" },
    "version": { "type": "string", "minLength": 1 },
    "items": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["preparing", "ready", "authorized", "deployed", "rolled_back", "cancelled"]
    },
    "environments": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "rollback_plan": { "type": "string" },
    "backup_restore_check": { "type": "string" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "authorization": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean", "const": true },
        "record": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
