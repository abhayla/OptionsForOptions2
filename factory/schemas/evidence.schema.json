{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://startup-factory/schemas/evidence.schema.json",
  "title": "Evidence",
  "description": "evidence/<W-id>/<AC-id>.md frontmatter",
  "type": "object",
  "required": ["work_item", "ac", "result", "verified_by", "date"],
  "properties": {
    "work_item": { "type": "string", "pattern": "^W-\\d{3,}$" },
    "ac": { "type": "string", "pattern": "^AC-\\d+$" },
    "result": { "type": "string", "enum": ["pass", "fail"] },
    "verified_by": { "type": "string", "minLength": 1 },
    "builder": { "type": "string" },
    "date": { "type": "string", "minLength": 1 },
    "commands": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  },
  "additionalProperties": true
}
