{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://startup-factory/schemas/evidence.schema.json",
  "title": "Evidence",
  "description": "evidence/<W-id>/<AC-id>.md frontmatter",
  "type": "object",
  "required": ["work_item", "ac", "result", "verified_by", "date"],
  "properties": {
    "work_item": { "type": "string", "pattern": "^W-\\d{3,}$" },
    "ac": { "type": "string", "pattern": "^AC-\\d+$" },
    "result": { "type": "string", "enum": ["pass", "fail"] },
    "verified_by": { "type": "string", "minLength": 1 },
    "builder": { "type": "string" },
    "date": { "type": "string", "minLength": 1 },
    "ac_fp": {
      "description": "first 12 hex of spec_text.fingerprint(<the proved criterion's text>): python tools/ac_fp.py REQ AC",
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "requirement": {
      "description": "the requirement this evidence proves; required with ac_fp (python tools/ac_fp.py REQ AC --yaml)",
      "type": "string",
      "pattern": "^REQ-\\d{3,}$"
    },
    "commands": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  },
  "if": { "required": ["ac_fp"] },
  "then": { "required": ["requirement"] },
  "additionalProperties": true
}
