{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://startup-factory/schemas/requirement.schema.json",
  "title": "Requirement",
  "description": "spec/requirements/REQ-###.md frontmatter",
  "type": "object",
  "required": ["id", "title", "statement", "source", "owner", "status", "layer", "section", "acceptance_criteria"],
  "properties": {
    "id": { "type": "string", "pattern": "^REQ-\\d{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "origin": { "type": "string" },
    "owner": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["Draft", "Specified", "Approved", "Planned", "Implementing", "Implemented", "Testing", "Verified", "Reviewed", "Released", "Delivered-before-trace", "Superseded"]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d+$" },
          "text": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "business_rules": { "type": "array", "items": { "type": "string" } },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "layer": { "type": "string", "enum": ["core", "foundation", "feature", "polish"] },
    "risk": { "type": "string", "enum": ["high", "normal"] },
    "risk_reason": { "type": "string" },
    "skeleton": { "type": "boolean" },
    "smoke": { "type": "array", "items": { "type": "string" } },
    "spec_refs": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": "object",
      "properties": {
        "tests": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "verified_by": { "type": "string" },
        "reviewed_by": { "type": "string" }
      },
      "additionalProperties": true
    },
    "release": { "type": "string" },
    "section": { "type": "string", "pattern": "\\S" },
    "distinct_from": { "type": "array", "items": { "type": "string" } },
    "confirmed_against": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z]+-\\d+ #[0-9a-f]{12}$" } },
    "delivered_in": { "type": "string", "pattern": "^docs/milestones/\\S+-report\\.md$" },
    "superseded_by": { "type": "string", "pattern": "^(REQ-\\d{3,}|OD-\\d+|ADR-\\d{3,})$" },
    "split_from": { "type": "string", "pattern": "^REQ-\\d{3,}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "Delivered-before-trace" } }, "required": ["status"] },
      "then": { "required": ["delivered_in"] }
    },
    {
      "if": { "properties": { "status": { "const": "Superseded" } }, "required": ["status"] },
      "then": { "required": ["superseded_by"] }
    }
  ],
  "additionalProperties": true
}
