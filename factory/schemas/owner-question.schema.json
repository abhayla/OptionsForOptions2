{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://startup-factory/schemas/owner-question.schema.json",
  "title": "Owner question",
  "description": "owner-questions/OQ-###.md frontmatter. The status page's 'Needs you' section lists exactly the open ones; nothing else feeds it (REQ-008).",
  "type": "object",
  "required": ["id", "asked", "question", "recommendation", "spec_basis", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^OQ-\\d{3,}$" },
    "asked": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "spec_basis": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["open", "answered"] },
    "answer_ref": { "type": "string", "minLength": 1 }
  },
  "if": { "properties": { "status": { "const": "answered" } }, "required": ["status"] },
  "then": { "required": ["answer_ref"] },
  "additionalProperties": true
}
