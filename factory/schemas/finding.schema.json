{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://startup-factory/schemas/finding.schema.json",
  "title": "Finding",
  "description": "knowledge/findings/<slug>.json — one proven failure-class finding, as described in knowledge/findings/README.md.",
  "type": "object",
  "required": ["id", "scope", "class", "mechanism", "first_seen", "fix", "detection"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "scope": {
      "type": "string",
      "enum": ["generic", "project"],
      "description": "generic: the class can happen in any project that uses the kit; project: it is about this repository only."
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "first_seen": {
      "type": "object",
      "required": ["date", "where", "evidence"],
      "properties": {
        "date": { "type": "string", "minLength": 1 },
        "where": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "fix": {
      "type": "string",
      "minLength": 1
    },
    "detection": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": { "type": "string", "enum": ["guarded", "unguarded"] },
        "checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
