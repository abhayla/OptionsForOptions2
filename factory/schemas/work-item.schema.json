{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://startup-factory/schemas/work-item.schema.json",
  "title": "Work Item",
  "description": "work/W-###.md frontmatter",
  "type": "object",
  "required": ["id", "title", "objective", "requirement_ids", "status", "tier", "core", "proof"],
  "properties": {
    "id": { "type": "string", "pattern": "^W-\\d{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "requirement_ids": { "type": "array", "items": { "type": "string", "pattern": "^REQ-\\d{3,}$" } },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "affected": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "tests_required": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["todo", "in_progress", "blocked", "in_review", "done", "dropped"]
    },
    "tier": { "type": "string", "enum": ["A", "B", "C"] },
    "core": { "type": "string", "minLength": 1 },
    "proof": { "type": "string", "minLength": 1 },
    "verification_status": { "type": "string" },
    "review_status": { "type": "string" },
    "release_status": { "type": "string" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" }
  },
  "additionalProperties": true
}
