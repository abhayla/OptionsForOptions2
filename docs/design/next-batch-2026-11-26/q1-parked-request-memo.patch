diff --git a/tests_app/test_request_memo.py b/tests_app/test_request_memo.py
new file mode 100644
index 0000000..92e97d8
--- /dev/null
+++ b/tests_app/test_request_memo.py
@@ -0,0 +1,125 @@
+"""REQ-049 AC-4 (Lane Q1): the GET request's read memo asks the same read once, never across requests, never across a
+write, and never hands one caller another's failure. Pure: no database."""
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+from ofo_app import request_memo
+
+
+def _counter():
+    calls = []
+
+    async def loader(value="v", *, boom=False, gate: asyncio.Event | None = None):
+        calls.append(value)
+        if gate is not None:
+            await gate.wait()
+        if boom:
+            raise RuntimeError("read failed")
+        return value
+    return calls, loader
+
+
+async def test_same_key_is_read_once_inside_a_get_request() -> None:
+    calls, loader = _counter()
+    token = request_memo.start("GET")
+    try:
+        assert await request_memo.cached(("k", 1), loader) == "v"
+        assert await request_memo.cached(("k", 1), loader) == "v"
+        assert await request_memo.cached(("k", 2), lambda: loader("w")) == "w"  # another argument: another read
+    finally:
+        request_memo.stop(token)
+    assert calls == ["v", "w"]
+
+
+async def test_no_memo_outside_a_get_request_and_none_across_requests() -> None:
+    calls, loader = _counter()
+    await request_memo.cached("k", loader)
+    await request_memo.cached("k", loader)
+    assert calls == ["v", "v"]  # no request: every call reads
+    post = request_memo.start("POST")
+    assert post is None  # a write method gets no memo
+    await request_memo.cached("k", loader)
+    await request_memo.cached("k", loader)
+    assert calls == ["v", "v", "v", "v"]
+    for _ in range(2):  # two GET requests: each reads once; nothing is shared
+        token = request_memo.start("GET")
+        await request_memo.cached("k", loader)
+        await request_memo.cached("k", loader)
+        request_memo.stop(token)
+    assert calls == ["v"] * 6
+
+
+async def test_a_write_clears_the_memo() -> None:
+    calls, loader = _counter()
+    token = request_memo.start("GET")
+    try:
+        await request_memo.cached("k", loader)
+        request_memo.clear()  # what the cursor hook does on any non-read statement
+        await request_memo.cached("k", loader)
+    finally:
+        request_memo.stop(token)
+    assert calls == ["v", "v"]
+
+
+@pytest.mark.parametrize(("statement", "plain"), [
+    ("SELECT 1", True),
+    ("  select c.updated_at, e.call_distance from t", True),
+    ("WITH x AS (SELECT 1) SELECT * FROM x", True),
+    ("INSERT INTO t VALUES (1)", False),
+    ("UPDATE t SET a = 1", False),
+    ("WITH x AS (DELETE FROM t RETURNING 1) SELECT * FROM x", False),
+    ("SELECT set_config('ofo.rule_adjustment_no', $1, true)", False),
+    ("SELECT id FROM t FOR UPDATE", False),
+    ("SAVEPOINT sa_savepoint_1", False),
+    ("RELEASE SAVEPOINT sa_savepoint_1", False),
+])
+def test_only_a_plain_read_keeps_the_memo(statement: str, plain: bool) -> None:
+    assert request_memo.is_plain_read(statement) is plain
+
+
+async def test_a_failed_read_is_not_stored_and_raises_as_before() -> None:
+    calls, loader = _counter()
+    token = request_memo.start("GET")
+    try:
+        with pytest.raises(RuntimeError):
+            await request_memo.cached("k", lambda: loader(boom=True))
+        assert await request_memo.cached("k", loader) == "v"  # asked again, not a stored failure
+    finally:
+        request_memo.stop(token)
+    assert calls == ["v", "v"]
+
+
+async def test_a_waiter_never_gets_the_first_callers_failure() -> None:
+    calls, loader = _counter()
+    gate = asyncio.Event()
+    token = request_memo.start("GET")
+    try:
+        first = asyncio.ensure_future(request_memo.cached("k", lambda: loader("a", boom=True, gate=gate)))
+        await asyncio.sleep(0)
+        second = asyncio.ensure_future(request_memo.cached("k", lambda: loader("b")))  # arrives while the first runs
+        await asyncio.sleep(0)
+        gate.set()
+        with pytest.raises(RuntimeError):
+            await first
+        assert await second == "b"  # ran its OWN read
+    finally:
+        request_memo.stop(token)
+    assert calls == ["a", "b"]
+
+
+async def test_a_waiter_shares_the_read_in_flight() -> None:
+    calls, loader = _counter()
+    gate = asyncio.Event()
+    token = request_memo.start("GET")
+    try:
+        first = asyncio.ensure_future(request_memo.cached("k", lambda: loader("a", gate=gate)))
+        await asyncio.sleep(0)
+        second = asyncio.ensure_future(request_memo.cached("k", lambda: loader("b")))
+        await asyncio.sleep(0)
+        gate.set()
+        assert (await first, await second) == ("a", "a")
+    finally:
+        request_memo.stop(token)
+    assert calls == ["a"]
