diff --git a/backend/ofo_app/request_memo.py b/backend/ofo_app/request_memo.py
new file mode 100644
index 0000000..a109500
--- /dev/null
+++ b/backend/ofo_app/request_memo.py
@@ -0,0 +1,105 @@
+"""One GET request's read-through memo (REQ-049 AC-4, Lane Q1): the same database read, asked twice inside ONE request,
+is asked once. NO product behaviour: the second ask gets exactly the first ask's rows.
+
+Safety, by construction:
+
+- scope: ``RequestLog`` starts a memo for a GET / HEAD request only; any other request, the background workers and
+  tests have none (every call then runs its loader). The memo dies with the request (``stop`` empties it), so nothing
+  is ever shared across requests.
+- never across a write: ``install_db_events`` clears the memo on any statement that is not a plain read, so a
+  read-after-write inside one request (the stop-base backfill, then its re-read) always goes to the database.
+- keyed by the EXACT read: the caller names it (what it reads and every argument, user included).
+- only immutable values are kept (rows, scalars, frozen objects); a failed read stores nothing and raises as before.
+"""
+from __future__ import annotations
+
+import asyncio
+import re
+from collections.abc import Awaitable, Callable, Hashable
+from contextvars import ContextVar, Token
+from typing import Any
+
+_current: ContextVar[dict[Hashable, Any] | None] = ContextVar("ofo_request_memo", default=None)
+
+_WRITE_WORDS = re.compile(r"\b(INSERT|UPDATE|DELETE|MERGE|TRUNCATE|LOCK|COPY|CALL)\b", re.IGNORECASE)
+_SIDE_EFFECTS = ("set_config", "nextval", "setval", "advisory")
+_PLAIN_READS = ("SELECT", "WITH", "SHOW", "EXPLAIN")
+
+
+def start(method: str) -> Token | None:
+    """A memo for this request when it only reads (GET / HEAD), else None."""
+    return _current.set({}) if method in ("GET", "HEAD") else None
+
+
+def stop(token: Token | None) -> None:
+    if token is None:
+        return
+    memo = _current.get()
+    if memo is not None:
+        memo.clear()
+    _current.reset(token)
+
+
+def clear() -> None:
+    memo = _current.get()
+    if memo is not None:
+        memo.clear()
+
+
+def is_plain_read(statement: str) -> bool:
+    text = statement.lstrip()
+    if not text.upper().startswith(_PLAIN_READS):
+        return False
+    if _WRITE_WORDS.search(text):
+        return False
+    low = text.lower()
+    return not any(word in low for word in _SIDE_EFFECTS)
+
+
+async def cached[T](key: Hashable, loader: Callable[[], Awaitable[T]]) -> T:
+    """``await loader()`` once per ``key`` inside a GET request; outside one, every call runs the loader.
+
+    A second asker that arrives while the first read is still running waits for it (one read, not two). If that first
+    read fails or is cancelled, the waiter runs its OWN loader, so a failure is never handed to a caller that did not
+    run the read (exactly the behaviour without a memo)."""
+    memo = _current.get()
+    if memo is None:
+        return await loader()
+    entry = memo.get(key)
+    if isinstance(entry, tuple):
+        return entry[0]
+    if entry is not None:  # a read in flight
+        try:
+            return await asyncio.shield(entry)
+        except asyncio.CancelledError:
+            if not entry.cancelled():
+                raise  # this waiter itself was cancelled
+        return await loader()
+    flight: asyncio.Future = asyncio.get_running_loop().create_future()
+    memo[key] = flight
+    try:
+        value = await loader()
+    except BaseException:
+        flight.cancel()
+        if memo.get(key) is flight:
+            del memo[key]
+        raise
+    flight.set_result(value)
+    if memo.get(key) is flight:  # a write in between cleared it: nothing is kept
+        memo[key] = (value,)
+    return value
+
+
+def install_db_events(engine: Any) -> None:
+    """Clear the memo on any statement that is not a plain read (idempotent; engine = a SQLAlchemy sync engine)."""
+    from sqlalchemy import event  # noqa: PLC0415
+
+    if getattr(engine, "_ofo_request_memo", False):
+        return
+    engine._ofo_request_memo = True
+
+    def before(_conn: Any, _cursor: Any, statement: str, *_rest: Any) -> None:
+        if not is_plain_read(statement):
+            clear()
+
+    event.listen(engine, "before_cursor_execute", before)
