--- a/tests_app/test_side_closed_alert.py
+++ b/tests_app/test_side_closed_alert.py
@@ -202,3 +202,18 @@ async def test_ask_again_each_time_the_side_closes_again(db, answer):
     # an OPEN row for the side stops a duplicate
     assert await side_closed.raise_if_closed(db, user, sid, CALL_EXITED, at=LATER) is None
     assert [r.id for r in await aa.unanswered(db, user)] == [again]
+
+
+async def test_m4_the_no_plan_lapse_leaves_the_side_closed_question_open_and_raises_it_once(db):
+    """Lane M item 4 (PC trade B-P2, no plan, call side closed, no row): a no-plan trade's open records close every
+    rebuild as not_monitored (ADR-330 (11)); its side_closed question is not a plan record and stays open, so the next
+    rebuild does not raise it a second time ("ask again" is per closure episode, ADR-330 (33))."""
+    from sqlalchemy.ext.asyncio import AsyncSession  # noqa: PLC0415
+
+    user, sid = await _setup(db)
+    first = await side_closed.raise_if_closed(db, user, sid, CALL_EXITED, at=AT)
+    session = AsyncSession(bind=db, join_transaction_mode="create_savepoint", expire_on_commit=False)
+    await background._lapse_exited(session, user, sid, "not_monitored", at=LATER)  # the lister's no-plan path
+    await session.close()
+    assert [(r.id, r.outcome) for r in await aa.unanswered(db, user)] == [(first, "open")]
+    assert await side_closed.raise_if_closed(db, user, sid, CALL_EXITED, at=LATER) is None  # one row, not two
