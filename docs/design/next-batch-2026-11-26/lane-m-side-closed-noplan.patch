--- a/tests_app/test_background_cycle.py
+++ b/tests_app/test_background_cycle.py
@@ -717,6 +717,45 @@ async def test_owner_lister_watches_nothing_for_a_strategy_with_no_plan_and_open
     assert closed == [("owner", FIRST_ID, "not_monitored")]  # its open alerts close (a definite answer, P1b)
 
 
+async def test_m4_a_no_plan_trade_is_still_handed_to_the_side_closed_check(scn, monkeypatch):
+    """Lane M item 4, 27 Nov (PC trade B-P2: call side closed, no plan, NO side_closed row at 11:42 or 13:03). ADR-330
+    (11) withholds only adjustment suggestions and target / stop alerts from a no-plan trade; (2)(b) and (33) ask about
+    a closed side every time. The lister still watches nothing for it, but hands its tracked position to the
+    side-closed check (``Listed.side_only``)."""
+    _patch_store(monkeypatch, scn, [FIRST_ID])
+
+    async def resolve(_db, _owner, _sid, _stype):
+        return adjustment_check.Resolved("none", None, None, None, False, saved_before_adr247=False)
+    monkeypatch.setattr(adjustment_check, "resolve", resolve)
+
+    async def lapse_exited(*_a, **_k):
+        return None
+    monkeypatch.setattr(background, "_lapse_exited", lapse_exited)
+    out = await background.owner_lister(Prov(scn))
+    assert out == []
+    assert [w.strategy_id for w in out.side_only] == [FIRST_ID]
+    assert out.side_only[0].tracked is not None
+
+
+async def test_m4_the_rebuild_runs_the_side_closed_check_for_the_no_plan_trades_too(scn):
+    prov, now = Prov(scn), [scn.clock_at]
+    asked: list[int] = []
+    planned = _watched(scn, 1)
+    spare = background.SideWatch("owner", 999, planned[0].tracked)
+
+    class Gate(FakeGate):
+        async def raise_side_closed(self, w, _at):
+            asked.append(w.strategy_id)
+
+    async def lister():
+        return background.Listed(planned, (), side_only=(spare,))
+    w = background.Worker(provider_for=lambda _o: prov, lister=lister, clock=lambda: now[0], settings=_settings(),
+                          preferences=_prefs, recorder=Calls(), gate_store=Gate())
+    await w.rebuild()
+    assert sorted(asked) == sorted([planned[0].strategy_id, 999])
+    assert [m.strategy_id for m in w.monitors] == [planned[0].strategy_id]  # still nothing else watched for it
+
+
 async def test_owner_lister_skips_a_strategy_whose_instrument_list_raises(scn, monkeypatch):
     _patch_store(monkeypatch, scn, [FIRST_ID])
     prov = Prov(scn)
