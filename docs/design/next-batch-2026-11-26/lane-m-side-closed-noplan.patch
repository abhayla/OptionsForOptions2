                 _keep_recent(self.errors, (w.strategy_id, type(exc).__name__))
 
-    async def _raise_side_closed_all(self, monitors: list[Watched]) -> None:
+    async def _raise_side_closed_all(self, monitors: list[Any]) -> None:
