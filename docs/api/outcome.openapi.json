          "instrument_id": {
            "pattern": "^[A-Z][A-Z_]{0,15}:[0-9]{1,12}$",
            "title": "Instrument Id",
            "type": "string"
          },
          "symbol": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_\\-.]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          }
        },
        "required": [
          "instrument_id",
          "symbol",
          "bid",
          "ask",
          "health"
        ],
        "title": "AdvancedLegOut",
        "type": "object"
      },
