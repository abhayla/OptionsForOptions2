      "LegIn": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Action",
            "type": "string"
          },
          "captured_at": {
            "description": "when the planned entry was captured (ADR-068)",
            "format": "date-time",
            "title": "Captured At",
            "type": "string"
          },
          "instrument_id": {
            "examples": [
              "NSE_FO:44624"
            ],
            "pattern": "^[A-Z][A-Z_]{0,15}:[0-9]{1,12}$",
            "title": "Instrument Id",
            "type": "string"
          },
          "lots": {
            "exclusiveMinimum": 0.0,
            "maximum": 10000.0,
            "title": "Lots",
            "type": "integer"
          },
          "planned_entry": {
            "description": "the planned entry price, a decimal string (never a float)",
            "examples": [
              "104.65"
            ],
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "title": "Planned Entry",
            "type": "string"
          }
        },
        "required": [
          "instrument_id",
          "action",
          "lots",
          "planned_entry",
          "captured_at"
        ],
        "title": "LegIn",
        "type": "object"
      },
