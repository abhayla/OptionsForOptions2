              }
            ],
            "title": "Range End",
            "description": "the last scenario level in index points; sent with range_start",
            "examples": [
              "23600"
            ]
          },
          "fallback": {
            "type": "boolean",
            "title": "Fallback",
            "description": "true when this is the REST refresh of a screen whose own live socket dropped (ADR-077): the answer is then the not-live state whoever else subscribes to the same contracts",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "underlying",
          "legs"
        ],
        "title": "OutcomeRequest"
