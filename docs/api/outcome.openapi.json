            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9]\\d{0,5}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Range Start",
            "description": "the first scenario level in index points; sent with range_end",
            "examples": [
              "22800"
            ]
          },
          "range_end": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9]\\d{0,5}$"
