  "info": {
    "title": "OptionsForOptions2 API - outcome",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/strategies/outcome": {
      "post": {
        "operationId": "strategy_outcome_api_strategies_outcome_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutcomeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutcomeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Strategy Outcome"
      }
    }
  }
