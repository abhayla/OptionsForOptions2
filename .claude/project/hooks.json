{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/secret_scan.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"" }
        ] },
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/verifier_inflight_gate.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"" }
        ] },
      { "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/gate_before_commit.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"" },
          { "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/merge_route_gate.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"" },
          { "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/issue_route_gate.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"" },
          { "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/verifier_inflight_gate.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"" },
          { "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/link_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"" }
        ] },
      { "matcher": "Agent|Task",
        "hooks": [
          { "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/agent_brief_gate.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"" }
        ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/edit_lint.py\"; [ -f \"$f\" ] || exit 0; python \"$f\"",
            "timeout": 15 }
        ] }
    ]
  },
  "permissions": {}
}
