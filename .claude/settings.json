{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_presence_check.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/evidence_claim_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/answer_writeback_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/recorder.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/spec_basis_gate.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_budget_required.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_model_required.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/git_hook_bypass_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/git_discard_uncommitted_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/git_stash_worktree_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/verifier_write_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/kit_file_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|SendMessage|RemoteTrigger|Monitor|Workflow|Agent|Task|Skill|mcp__.*|CronCreate|ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/secret_scan.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/gate_before_commit.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/verifier_write_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/verifier_write_guard.py\"; [ -f \"$f\" ] || exit 0; python \"$f\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.factory/**)",
      "Write(.factory/**)",
      "MultiEdit(.factory/**)"
    ]
  }
}
