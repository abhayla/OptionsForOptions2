# A user-level git ignore may exclude the kit's dotfolder project-wide; this project's kit lives
# there, so re-include it here (repo .gitignore wins over core.excludesFile). Keep the personal
# local-only file in that folder ignored.
!.claude/
!**/.claude/
.claude/*.local.json
# user-level hook miss logs written into the project's dotfolder: per-machine, never committed
.claude/.*-misses.log

# views/ is generated output — regenerate it, do not hand-edit or commit stale copies.
# .factory/authorizations/ holds owner-only single-use records — never commit real ones.
views/*
!views/spec-digest.md
!views/build-order.md
!views/README.md
# kit 1.8.0 item 2: the status page's local state and ci_local.py's test results stay local (already covered by
# views/* above, named so a future re-include cannot expose them); the page's link file is committed.
views/status-page.state.json
views/test-results*
!views/status-page.json
.factory/authorizations/*
!.factory/authorizations/README.md

# evidence_claim_guard.py's log-only default writes here; never commit a session's misses.
.factory/logs/*

# kit-tools-leave-untracked-caches: every kit tool run leaves compiled bytecode behind.
__pycache__/
*.pyc

# Python / Node local environments
.venv/
venv/
node_modules/
.pytest_cache/

# Local secrets (project .env) - never commit
.env
